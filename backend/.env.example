# Development defaults only. Use private values for deployed environments.
PROJECT_NAME=CompeteFastAPI
APP_VERSION=0.1.0
API_PREFIX=/api

DATABASE_URL=postgresql+asyncpg://compete_user:compete_password@localhost:5432/compete_db
REDIS_URL=redis://localhost:6379/0

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TRUSTED_PROXIES=[]
DEFAULT_RATE_LIMIT=60/minute
RATE_LIMIT_COMPARE=30/minute
INIT_DB_ON_STARTUP=false
ENABLE_BACKGROUND_SCHEDULER=true
SNAPSHOT_SYNC_INTERVAL_HOURS=1
BACKGROUND_SYNC_CONCURRENCY=5
