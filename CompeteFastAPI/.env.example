# ========================================================
# CompeteFastAPI — Environment Variable Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ========================================================

# Server Configuration
PROJECT_NAME="CompeteFastAPI"
APP_VERSION="0.1.0"
API_PREFIX="/api"
APP_PORT=8000

# LeetCode Upstream Configuration
LEETCODE_GRAPHQL_URL="https://leetcode.com/graphql"
LEETCODE_TIMEOUT_SECONDS=12.0
LEETCODE_MAX_RETRIES=3
LEETCODE_BACKOFF_FACTOR=1.5

# Redis Cache Configuration
# For Docker Compose:
REDIS_URL="redis://redis:6379/0"
# For Local Development (host):
# REDIS_URL="redis://localhost:6379/0"
REDIS_PORT=6379
CACHE_USER_STATS_TTL_SECONDS=600
CACHE_USER_PROBLEMS_TTL_SECONDS=1800
CACHE_USER_ACTIVITY_TTL_SECONDS=300

# PostgreSQL Database Configuration
POSTGRES_USER="compete_user"
POSTGRES_PASSWORD="compete_password"
POSTGRES_DB="compete_database"
POSTGRES_PORT=5432
# For Docker Compose:
DATABASE_URL="postgresql+asyncpg://compete_user:compete_password@postgres:5432/compete_database"
# For Local Development (host):
# DATABASE_URL="postgresql://compete_user:compete_password@localhost:5432/compete_database"

# Snapshot throttling — minimum seconds between per-user snapshots
SNAPSHOT_MIN_INTERVAL_SECONDS=86400
SNAPSHOT_RETENTION_DAYS=365

# Rate Limiting (SlowAPI)
DEFAULT_RATE_LIMIT="60/minute"
RATE_LIMIT_COMPARE="30/minute"

# Background Scheduler (APScheduler)
SNAPSHOT_SYNC_INTERVAL_HOURS=1
ENABLE_BACKGROUND_SCHEDULER=true

